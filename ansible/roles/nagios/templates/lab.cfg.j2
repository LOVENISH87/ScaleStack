# Managed by Ansible (configure_nagios.yml). Do not edit by hand.
{% set alb_host = alb_dns_name.split('://')[-1] %}

{% if tp_247_count.stdout | int == 0 %}
define timeperiod {
    timeperiod_name 24x7
    alias           24 Hours A Day, 7 Days A Week
    sunday          00:00-24:00
    monday          00:00-24:00
    tuesday         00:00-24:00
    wednesday       00:00-24:00
    thursday        00:00-24:00
    friday          00:00-24:00
    saturday        00:00-24:00
}
{% endif %}

define command {
    command_name lab_check_http_health
    command_line $USER1$/check_http -H $ARG1$ -u $ARG2$ -e 200 -t 10
}

define command {
    command_name lab_check_http_port
    command_line $USER1$/check_http -I $HOSTADDRESS$ -p $ARG1$ -u $ARG2$ -e 200 -t 10
}

define command {
    command_name lab_check_ssh
    command_line $USER1$/check_ssh -H $HOSTADDRESS$ -p 22 -t 10
}

define command {
    command_name lab_check_disk
    command_line $USER1$/check_disk -w 20% -c 10% -p /
}

define command {
    command_name lab_check_load
    command_line $USER1$/check_load -w 2.0,2.0,2.0 -c 4.0,4.0,4.0
}

define command {
    command_name lab_check_cpu_remote
    command_line $USER1$/check_system_metrics.py -H $HOSTADDRESS$ -p $ARG1$ -m cpu -w 70 -c 90
}

define command {
    command_name lab_check_mem_remote
    command_line $USER1$/check_system_metrics.py -H $HOSTADDRESS$ -p $ARG1$ -m mem -w 80 -c 95
}

define command {
    command_name lab_notify_host_by_email
    command_line /usr/bin/printf '%s\n' 'Host: $HOSTNAME$' 'State: $HOSTSTATE$' 'Output: $HOSTOUTPUT$' | /usr/bin/mail -s "ALERT Host $HOSTSTATE$: $HOSTNAME$" $CONTACTEMAIL$
}

define command {
    command_name lab_notify_service_by_email
    command_line /usr/bin/printf '%s\n' 'Host: $HOSTNAME$' 'Service: $SERVICEDESC$' 'State: $SERVICESTATE$' 'Output: $SERVICEOUTPUT$' | /usr/bin/mail -s "ALERT Service $SERVICESTATE$: $HOSTALIAS$ $SERVICEDESC$" $CONTACTEMAIL$
}

define contact {
    contact_name                    lab_admin
    alias                           Lab Administrator
    email                           {{ nagios_alert_email | default('nagiosadmin@example.com') }}
    host_notification_period        24x7
    service_notification_period     24x7
    host_notification_options       d,r
    service_notification_options    w,u,c,r
    host_notification_commands      lab_notify_host_by_email
    service_notification_commands   lab_notify_service_by_email
}

define contactgroup {
    contactgroup_name lab_admins
    alias             Lab Administrators
    members           lab_admin
}

define host {
    host_name           {{ alb_host }}
    alias               Lab ALB (health-gated patching)
    address             {{ alb_host }}
    max_check_attempts  3
    check_interval      1
    retry_interval      1
    check_period        24x7
    check_command       lab_check_http_health!{{ alb_host }}!{{ app_health_path | default('/health') }}
    notification_interval 30
    notification_period   24x7
    notification_options  d,r
    contact_groups       lab_admins
}

{% for ip in app_private_ips %}
define host {
    host_name           app-{{ loop.index }}
    alias               Lab app server {{ loop.index }} ({{ ip }})
    address             {{ ip }}
    max_check_attempts  3
    check_interval      1
    retry_interval      1
    check_period        24x7
    check_command       lab_check_ssh
    notification_interval 30
    notification_period   24x7
    notification_options  d,r
    contact_groups       lab_admins
}
{% endfor %}

