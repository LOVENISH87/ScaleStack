# Rendered at container start by entrypoint.sh (envsubst). Do not edit in place.
# ${ALB_DNS} is the public ALB DNS name; the Service host is cluster-internal.

define host {
    host_name               scalestack-alb
    alias                   ScaleStack ALB (public entry point)
    address                 ${ALB_DNS}
    max_check_attempts      3
    check_interval          1
    retry_interval          1
    check_period            24x7
    check_command           lab_check_http_host!${ALB_DNS}!/health
    notification_interval   30
    notification_period     24x7
    notification_options    d,r
    contact_groups          lab_admins
}

define host {
    host_name               scalestack-web
    alias                   ScaleStack Service (in-cluster ClusterIP)
    address                 scalestack-web.scalestack.svc.cluster.local
    max_check_attempts      3
    check_interval          1
    retry_interval          1
    check_period            24x7
    check_command           lab_check_http_service!80!/health
    notification_interval   30
    notification_period     24x7
    notification_options    d,r
    contact_groups          lab_admins
}

